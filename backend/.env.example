# 和风天气（留空则使用 mock 天气）
# 在 https://console.qweather.com 创建项目并获取 Key / API Host。
# 复制本文件为 backend/.env 后填写；不要提交真实 Key。
QWEATHER_KEY=
# 控制台的 API Host（例如 abcdef.re.qweatherapi.com）；留空使用 devapi.qweather.com
QWEATHER_HOST=

# 高德 Web 服务（留空则使用 mock 景点、直线距离）
# 在高德开放平台创建「Web 服务」Key；用于 POI 搜索与道路距离，不要用 JS API Key。
AMAP_WEB_KEY=

